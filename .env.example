# Dental App Environment Variables
# Copy this file to .env and fill in your values

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_ISSUER_URL=https://your-clerk-instance.clerk.accounts.dev

# Neon PostgreSQL
DATABASE_URL=s-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# GetStream.io
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_url_endpoint

# Inngest
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Sentry
SENTRY_DSN=https://your-key@o1.ingest.sentry.io/your-project
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# App
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
EXPO_PUBLIC_STREAM_API_KEY=your_stream_api_key
EXPO_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_url_endpoint
API_BASE_URL=http://localhost:3000
